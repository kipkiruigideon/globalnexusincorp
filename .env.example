# PostgreSQL connection string.
# Create a Postgres database (Railway or Render) and paste its connection URL here.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Secret used to sign session JWTs. Use a long, random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret"

# SMTP settings for sending verification-code emails (e.g. Brevo).
# If left unset, verification codes are logged to the server console instead.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-login"
SMTP_PASS="your-smtp-key"
SMTP_FROM="Global Nexus Inc <no-reply@yourdomain.com>"
